# Optional LOCAL settings. Never commit .env or credential values.
# DONNA_OPS_CONFIG=/absolute/profile/donna-ops.json
# OBSIDIAN_VAULT_PATH=/absolute/existing-vault
# Preserve configured model/provider and memory settings during migration.
# MNEMOSYNE_DATA_DIR=/absolute/profile/mnemosyne/data
# MNEMOSYNE_HOST_LLM_ENABLED=true
# Telegram and Google are optional. Use official private credential/OAuth flows.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=
