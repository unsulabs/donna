# Copy to .env and fill only what you use.
#   cp .env.example .env
# Never commit .env. Never paste secrets into chat.
# Model provider keys are usually set via `hermes setup` or a global ~/.hermes/.env.

# --- Profile paths (onboarding writes these) ---
# OBSIDIAN_VAULT_PATH=/absolute/path/to/Your-Donna-Vault
# MNEMOSYNE_DATA_DIR=/absolute/path/to/.hermes/profiles/donna/mnemosyne/data
# MNEMOSYNE_HOST_LLM_ENABLED=true

# --- Optional messaging ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=
# TELEGRAM_HOME_CHANNEL=

# --- Optional kanban board notify (scripts/kanban_board_notify.py) ---
# DONNA_KANBAN_BOARD=donna-ops
# DONNA_KANBAN_BOARD_DB=/absolute/path/to/.hermes/kanban/boards/donna-ops/kanban.db
# DONNA_KANBAN_NOTIFY_CURSOR=/absolute/path/to/cursor-file
# DONNA_KANBAN_NOTIFY_MAX=40

# --- Optional config guard (scripts/config_guard.py) ---
# DONNA_EXPECT_MODEL_PROVIDER=
# DONNA_EXPECT_MODEL_DEFAULT=

# --- Optional model providers (if not using global .env / hermes auth) ---
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
